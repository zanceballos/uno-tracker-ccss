rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    function session(sid) { return get(/databases/$(db)/documents/sessions/$(sid)).data; }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }
    match /meta/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /pastSessions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /sessions/{sid} {
      allow read: if true;
      allow write: if isAdmin();

      match /teams/{tid} {
        allow read: if true;
        allow write: if isAdmin();
        allow update: if signedIn()
          && session(sid).status == 'registration'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['size'])
          && ((request.resource.data.size == resource.data.size + 1 && request.resource.data.size <= 4)
            || (request.resource.data.size == resource.data.size - 1 && request.resource.data.size >= 0));
      }
      match /players/{pid} {
        allow read: if true;
        allow write: if isAdmin();
        allow delete: if signedIn() && request.auth.uid == pid
          && session(sid).status == 'registration';
        allow create: if signedIn() && request.auth.uid == pid
          && session(sid).status == 'registration'
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 30
          && request.resource.data.keys().hasOnly(['name', 'teamId', 'points', 'createdAt'])
          && request.resource.data.points == 0;
      }
      match /{sub}/{doc} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
  }
}
